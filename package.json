{
  "name": "floor-first",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"client,server\" -c \"cyan,magenta\" \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "dev:all": "npm run dev",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "frontend": "npm run dev --workspace=frontend",
    "backend": "npm run dev --workspace=backend",
    "server": "npm run dev --workspace=backend",
    "server:dev": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "build:dev": "npm run build:dev --workspace=frontend",
    "seed": "npm run seed --workspace=backend",
    "start": "npm run start --workspace=backend",
    "lint": "npm run lint --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "test": "npm run test --workspace=frontend",
    "test:api": "npm run test:api --workspace=backend",
    "test:watch": "npm run test:watch --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
