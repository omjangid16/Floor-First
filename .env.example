# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8080

# ==============================================================================
# MONGODB DATABASE CONFIGURATION
# Local: mongodb://127.0.0.1:27017/floor_first
# Cloud (Atlas): mongodb+srv://<username>:<password>@cluster0.mongodb.net/floor_first?retryWrites=true&w=majority
# ==============================================================================
MONGO_URI=mongodb://127.0.0.1:27017/floor_first

# ==============================================================================
# AUTHENTICATION & SECURITY (NEVER SHARE ON GITHUB)
# Generate a strong 64-byte random string for production
# ==============================================================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# ==============================================================================
# SEED & ADMIN CREDENTIALS (SENSITIVE)
# ==============================================================================
DEMO_USER_EMAIL=demo@floorfirst.ae
DEMO_USER_PASSWORD=your_demo_password
ADMIN_EMAIL=admin@floorfirst.ae
ADMIN_PASSWORD=your_admin_password

# ==============================================================================
# EMAIL / SMTP NOTIFICATIONS (OPTIONAL / SENSITIVE)
# ==============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Floor First <noreply@floorfirst.ae>"

# ==============================================================================
# PAYMENT GATEWAY API KEYS (OPTIONAL / SENSITIVE)
# ==============================================================================
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ==============================================================================
# FRONTEND CLIENT ENVIRONMENT VARIABLES (Vite)
# ==============================================================================
VITE_API_URL=http://localhost:5000/api
